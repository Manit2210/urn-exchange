# Copy to .env (git-ignored) and load it with `set -a; . ./.env; set +a`, or export these in your shell.
# Names only: put your own values in.
# The runner reads keys from the environment; it never reads key values from config files.

# Required for configs/v1.yaml and configs/smoke.yaml (every model goes through OpenRouter).
OPENROUTER_API_KEY=

# Optional: the direct Gemini API route (provider: gemini_api; pip install -e ".[gemini]").
GEMINI_API_KEY=

# Optional: direct OpenAI (provider: openai_responses) and Anthropic (provider: anthropic) routes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
